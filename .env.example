# ================================================================
# KONFIGURASI SISTEM SIM-LAPOR & RKT SDN KALISALAK 01
# INTEGRASI CLOUDFLARE D1 (DATABASE) & CLOUDFLARED (TUNNEL)
# ================================================================

# ----------------------------------------------------------------
# 1. CLOUDFLARE D1 (SQLITE SERVERLESS DATABASE)
# Dapatkan dari Cloudflare Dashboard:
# -> Storage & Databases -> D1 -> Pilih Database Anda
# ----------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=

# API Token Cloudflare dengan izin akses D1 Edit:
# -> Cloudflare Dashboard -> Profil Anda (Kanan Atas) -> API Tokens -> Create Token
# -> Buat Custom Token:
#    Permissions: Account -> D1 -> Edit
#    Account Resources: All accounts (atau akun spesifik Anda)
CLOUDFLARE_API_TOKEN=

# ----------------------------------------------------------------
# 2. CLOUDFLARE TUNNEL (CLOUDFLARED)
# Domain: laporan_sdnkalisalak01.develzy.my.id
# Dapatkan Tunnel Token dari:
# -> Cloudflare Zero Trust Dashboard -> Networks -> Tunnels
# -> Buat Tunnel baru, tambahkan Public Hostname:
#    Hostname: laporan_sdnkalisalak01.develzy.my.id
#    Service:  http://localhost:3000
# -> Salin nilai token dari perintah "cloudflared.exe tunnel run --token <TOKEN>"
# ----------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=

# Domain Publik
PUBLIC_DOMAIN=laporan_sdnkalisalak01.develzy.my.id

# ----------------------------------------------------------------
# 3. CLOUDINARY (MEDIA & FOTO RESMI)
# ----------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=ixjihcvx
CLOUDINARY_API_KEY=691765734874534
CLOUDINARY_API_SECRET=bGDsN9ZSA1F837suY3vibpDpiqo

# ----------------------------------------------------------------
# 4. SERVER LOCAL CONFIG & TOKEN AKSES RESMI (OPSI B)
# ----------------------------------------------------------------
PORT=2025
AUTO_OPEN=true
APP_ACCESS_TOKEN=kalisalak01_secure_key_9f82a17b3c
