<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta charset="utf-8">
<title>DASHBOARD LAPORAN//SDN KALISALAK 01</title>
<HTA:APPLICATION 
    ID="DashboardLaporan" 
    APPLICATIONNAME="DASHBOARD LAPORAN//SDN KALISALAK 01" 
    BORDER="thin" 
    INNERBORDER="no" 
    SCROLL="no" 
    SINGLEINSTANCE="yes" 
    WINDOWSTATE="normal"
    ICON="assets\logo.ico"
    NAVIGABLE="yes"
    SYSMENU="yes"
    MAXIMIZEBUTTON="yes"
    MINIMIZEBUTTON="yes"
>
<link rel="icon" type="image/x-icon" href="assets/logo.ico">
<style>
* { 
    box-sizing: border-box; 
    margin: 0; 
    padding: 0; 
    font-family: 'Consolas', 'Lucida Console', 'Courier New', monospace; 
    user-select: none; 
}

html, body { 
    width: 100%; 
    height: 100%; 
    background: #020704; 
    color: #00ff66; 
    overflow: hidden; 
    position: relative;
}

/* HEADER UTAMA */
.header { 
    position: absolute;
    top: 10px;
    left: 10px;
    right: 10px;
    height: 50px;
    border: 1px solid #00ff66; 
    padding: 7px 14px; 
    background: #00180c; 
    box-shadow: 0 0 14px rgba(0, 255, 102, 0.18);
}

.brand {
    float: left;
    height: 34px;
    line-height: 34px;
    font-size: 1.05rem;
    font-weight: bold;
    letter-spacing: 1px;
    color: #00ff88;
}

.brand img {
    height: 32px;
    width: auto;
    vertical-align: middle;
    margin-right: 10px;
}

.header-badges {
    float: right;
    height: 34px;
    line-height: 34px;
}

.badge {
    display: inline-block;
    background: #00220a;
    color: #00ff88;
    padding: 3px 8px;
    border: 1px solid #00aa44;
    font-size: 0.8rem;
    font-weight: bold;
    letter-spacing: 0.5px;
    margin-left: 6px;
    vertical-align: middle;
}

.badge-online {
    background: #003a14;
    border-color: #00ff66;
    color: #ffffff;
    box-shadow: 0 0 8px rgba(0, 255, 102, 0.4);
}

/* CONTAINER RESPONSIF 2X2 */
.dashboard-grid { 
    position: absolute;
    top: 68px;
    bottom: 10px;
    left: 10px;
    right: 10px;
}

.dash-row {
    position: absolute;
    left: 0;
    right: 0;
    width: 100%;
}

.dash-row.row-top {
    top: 0;
    height: 48.5%;
}

.dash-row.row-bottom {
    bottom: 0;
    height: 48.5%;
}

.dash-card { 
    position: absolute;
    top: 0;
    bottom: 0;
    width: 49.3%;
    border: 1px solid #00aa44; 
    background: #001006; 
    box-shadow: inset 0 0 16px rgba(0, 255, 102, 0.05);
    padding: 10px 12px; 
    overflow: hidden;
}

.dash-card.card-left {
    left: 0;
}

.dash-card.card-right {
    right: 0;
}

.card-title { 
    height: 24px;
    line-height: 20px;
    font-size: 0.88rem; 
    color: #00ff66; 
    margin-bottom: 6px; 
    font-weight: bold; 
    border-bottom: 1px solid #00441a; 
    padding-bottom: 4px; 
    letter-spacing: 0.5px;
    overflow: hidden;
}

.card-title .title-left { float: left; }
.card-title .title-right { float: right; font-size: 0.75rem; color: #00aa44; }

/* SCROLL AREA MANDIRI */
.scroll-area { 
    position: absolute;
    top: 38px;
    bottom: 10px;
    left: 12px;
    right: 12px;
    overflow-y: auto; 
    overflow-x: hidden;
    padding-right: 4px; 
}
.scroll-area::-webkit-scrollbar { width: 5px; }
.scroll-area::-webkit-scrollbar-track { background: #001206; }
.scroll-area::-webkit-scrollbar-thumb { background: #00aa44; }

/* KARTU 1: OPERATIONS */
.mission { 
    background: #001c0c; 
    border-left: 3px solid #00ff66; 
    padding: 6px 8px; 
    margin-bottom: 6px; 
    font-size: 0.78rem; 
    line-height: 1.35;
}
.mission strong { color: #99ffbb; }

/* KARTU 2: STATS & HEALTH */
.stats-table {
    width: 100%;
    margin-bottom: 8px;
    border-collapse: separate;
    border-spacing: 6px;
}

.stat-box { 
    border: 1px solid #004d1f; 
    background: #001a0a;
    padding: 6px 8px; 
    font-size: 0.78rem; 
    overflow: hidden;
}
.stat-box .stat-label { float: left; color: #00dd55; }
.stat-box .stat-val { float: right; color: #ffffff; font-weight: bold; }

/* TOMBOL UTAMA MASUK DASHBOARD */
.btn-enter-dashboard {
    display: block;
    background: #00772e;
    border: 2px solid #00ff66;
    color: #ffffff;
    font-size: 0.92rem;
    font-weight: bold;
    letter-spacing: 1.5px;
    padding: 9px 8px;
    margin-top: 8px;
    cursor: pointer;
    box-shadow: 0 0 14px rgba(0, 255, 102, 0.4);
    text-align: center;
}
.btn-enter-dashboard:hover {
    background: #00ff66;
    color: #001808;
    box-shadow: 0 0 22px rgba(0, 255, 102, 0.8);
}

.progress-section { 
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
}
.progress-label { 
    font-size: 0.78rem; 
    margin-bottom: 4px; 
    overflow: hidden;
}
.progress-label .pl-left { float: left; }
.progress-label .pl-right { float: right; color: #00ff88; font-weight: bold; }

.progress-bar { 
    width: 100%; 
    height: 16px; 
    background: #001a08; 
    border: 1px solid #00ff66; 
    overflow: hidden; 
}
.progress-fill { 
    height: 100%; 
    width: 85%; 
    background: #00aa44; 
}

/* KARTU 3: LOG ACTIVITY */
.log-line { 
    font-size: 0.76rem; 
    color: #00dd55; 
    margin-bottom: 3px; 
    line-height: 1.3;
    word-break: break-all;
}
.log-time { color: #008833; font-weight: bold; margin-right: 4px; }
.log-tag { color: #88ffaa; font-weight: bold; }

/* KARTU 4: BUTTONS & INFO */
.btn-table {
    width: 100%;
    margin-bottom: 6px;
    border-collapse: separate;
    border-spacing: 6px;
}

.btn { 
    border: 1px solid #00aa44; 
    background: #00260e; 
    color: #00ff66; 
    padding: 8px 4px; 
    text-align: center; 
    cursor: pointer; 
    font-size: 0.78rem; 
    font-weight: bold; 
    display: block;
}
.btn:hover { 
    background: #00ff66; 
    color: #001206; 
}
.btn-danger {
    border-color: #ff3333;
    color: #ff5555;
    background: #2b0808;
}
.btn-danger:hover {
    background: #ff3333;
    color: #ffffff;
}

.net-info {
    position: absolute;
    bottom: 10px;
    left: 12px;
    right: 12px;
    font-size: 0.75rem;
    color: #00aa55;
    line-height: 1.4;
    border-top: 1px solid #003314;
    padding-top: 6px;
}
</style>
</head>
<body onunload="onAppExit()">

<!-- HEADER UTAMA -->
<div class="header">
    <div class="brand">
        <span>DASHBOARD LAPORAN//SDN KALISALAK 01</span>
    </div>
    <div class="header-badges">
        <span class="badge badge-online">STATUS: ONLINE</span>
        <span class="badge" id="port-badge">PORT: 2025</span>
        <span class="badge">SECURITY: LEVEL 5</span>
    </div>
</div>

<!-- CONTAINER 2X2 RESPONSIF BULLETPROOF -->
<div class="dashboard-grid">
    
    <!-- BARIS 1 -->
    <div class="dash-row row-top">
        <!-- KARTU 1: OPERATIONS & MISSIONS -->
        <div class="dash-card card-left">
            <div class="card-title">
                <span class="title-left">Active Operations / Missions</span>
                <span class="title-right">[4 ACTIVE]</span>
            </div>
            <div class="scroll-area">
                <div class="mission">
                    <strong>[x] Operation Cloudflare D1 Sync</strong><br>
                    Cluster: 6ae50a84-d394-4d98-a392-0b3c9a3e00b2<br>
                    Status: Edge Handshake Verified [OK]
                </div>
                <div class="mission">
                    <strong>[x] Zero-Trust Edge Tunnel</strong><br>
                    Target: <span id="mission-domain">laporan_sdnkalisalak01.develzy.my.id</span><br>
                    Status: Route Engaged (Singapore POP) [ONLINE]
                </div>
                <div class="mission">
                    <strong>[x] Cloudinary Media Asset Pipeline</strong><br>
                    Bucket: cloud ixjihcvx<br>
                    Status: Secured [SSL Pinning / AES-256]
                </div>
                <div class="mission">
                    <strong>[x] Dual-Storage Coherency Engine</strong><br>
                    Mode: Local IndexedDB &lt;--&gt; Cloudflare D1 Realtime<br>
                    Status: Data Coherency Verified [SYNCED]
                </div>
            </div>
        </div>

        <!-- KARTU 2: SYSTEM TELEMETRY -->
        <div class="dash-card card-right">
            <div class="card-title">
                <span class="title-left">System Status &amp; Telemetry</span>
                <span class="title-right" id="pulse" style="color:#00ff66;">● LIVE</span>
            </div>
            
            <table class="stats-table">
                <tr>
                    <td style="width:50%;">
                        <div class="stat-box">
                            <span class="stat-label">CPU Usage:</span>
                            <span class="stat-val" id="cpu">38%</span>
                        </div>
                    </td>
                    <td style="width:50%;">
                        <div class="stat-box">
                            <span class="stat-label">Memory Heap:</span>
                            <span class="stat-val" id="mem">1.22 GB</span>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>
                        <div class="stat-box">
                            <span class="stat-label">Network Traffic:</span>
                            <span class="stat-val" id="net">6.8 MB/s</span>
                        </div>
                    </td>
                    <td>
                        <div class="stat-box">
                            <span class="stat-label">Active Sockets:</span>
                            <span class="stat-val" id="sock">14</span>
                        </div>
                    </td>
                </tr>
            </table>
            
            <!-- TOMBOL UTAMA: MASUK DASHBOARD -->
            <div class="btn-enter-dashboard" onclick="openCloud()">
                &#128640; MASUK DASHBOARD
            </div>
            
            <div class="progress-section">
                <div class="progress-label">
                    <span class="pl-left">System Health &amp; Security Shield:</span>
                    <span class="pl-right" id="health-txt">88% [OPTIMAL]</span>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" id="pbar" style="width: 88%;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- BARIS 2 -->
    <div class="dash-row row-bottom">
        <!-- KARTU 3: LOG ACTIVITY (SCROLL MANDIRI) -->
        <div class="dash-card card-left">
            <div class="card-title">
                <span class="title-left">Live Security Activity Log</span>
                <span class="title-right">AUTO-ROLLING</span>
            </div>
            <div class="scroll-area" id="logbox"></div>
        </div>

        <!-- KARTU 4: QUICK COMMAND & CONTROL -->
        <div class="dash-card card-right">
            <div class="card-title">
                <span class="title-left">Quick Command Control</span>
            </div>
            
            <table class="btn-table">
                <tr>
                    <td style="width:50%;"><div class="btn" onclick="openPortal()">Local Portal (2025)</div></td>
                    <td style="width:50%;"><div class="btn" onclick="openCloud()">Cloud Edge (Public)</div></td>
                </tr>
                <tr>
                    <td><div class="btn" onclick="runAudit()">Security Audit</div></td>
                    <td><div class="btn btn-danger" onclick="shutdownServer()">MATIKAN SERVER</div></td>
                </tr>
            </table>

            <div class="net-info">
                &gt; Local Loopback : <b id="local-info">http://localhost:2025</b><br>
                &gt; Public Domain : <b id="cloud-info">https://laporan_sdnkalisalak01.develzy.my.id</b><br>
                &gt; Server Engine : Node.js Daemon &amp; Cloudflare Tunnel [ACTIVE]
            </div>
        </div>
    </div>

</div>

<script>
// Window Size & Center
try {
    window.resizeTo(980, 680);
    window.moveTo((screen.availWidth - 980) / 2, (screen.availHeight - 680) / 2);
} catch (e) {}

var shell = null;
var fso = null;
var baseDir = "b:\\WEBSITE\\.administrasi_sd";
var appPort = "2025";
var publicDomain = "laporan_sdnkalisalak01.develzy.my.id";
var tunnelToken = "eyJhIjoiOGZiZWM5Mjk1YmI5YTk1ODBjYjc1NmE4NjBlMTljOWUiLCJ0IjoiMjljOWU2YjctYzYxZS00MzNiLWIzY2YtYjA2ZDQ4ZTlkZTkwIiwicyI6IllXUm1PV016T0dVdE5ERTFOQzAwTldOaExXSTROR010T0ROaE1HWXdPR0kyWVdRMyJ9";
var appAccessToken = "kalisalak01_secure_key_9f82a17b3c";

try {
    shell = new ActiveXObject("WScript.Shell");
    fso = new ActiveXObject("Scripting.FileSystemObject");
    
    // Dapatkan folder lokasi file .hta ini berada dengan path Windows yang valid
    var raw = window.location.pathname || "";
    try { raw = decodeURIComponent(raw); } catch(e) {}
    raw = raw.replace(/^file:[\\/]+/i, '');
    raw = raw.replace(/^[\\/]+/, '');
    raw = raw.replace(/\//g, '\\');
    if (fso && fso.FileExists(raw)) {
        baseDir = fso.GetParentFolderName(raw);
    }
} catch (e) {}

// Baca .env langsung dari HTA (jika ada nilai baru)
function loadEnv() {
    try {
        var envPath = baseDir + "\\.env";
        if (fso && fso.FileExists(envPath)) {
            var file = fso.OpenTextFile(envPath, 1);
            while (!file.AtEndOfStream) {
                var line = file.ReadLine().trim();
                if (line && line.indexOf('#') !== 0 && line.indexOf('=') > 0) {
                    var parts = line.split('=');
                    var key = parts[0].trim();
                    var val = parts.slice(1).join('=').trim();
                    if (key === 'PORT') appPort = val;
                    if (key === 'PUBLIC_DOMAIN') publicDomain = val;
                    if (key === 'CLOUDFLARE_TUNNEL_TOKEN') tunnelToken = val;
                    if (key === 'APP_ACCESS_TOKEN') appAccessToken = val;
                }
            }
            file.Close();
        }
    } catch (e) {}
    
    // Update label tampilan
    var pBadge = document.getElementById('port-badge');
    if (pBadge) pBadge.innerText = 'PORT: ' + appPort;
    var lInfo = document.getElementById('local-info');
    if (lInfo) lInfo.innerText = 'http://localhost:' + appPort;
    var cInfo = document.getElementById('cloud-info');
    if (cInfo) cInfo.innerText = 'https://' + publicDomain;
    var mDom = document.getElementById('mission-domain');
    if (mDom) mDom.innerText = publicDomain;
}

// Jalankan Node dan Cloudflare Tunnel secara otomatis di latar belakang (Silent / Hidden)
function bootstrapServices() {
    if (!shell) return;
    
    addCustomLog("[KERNEL_BOOT]", "Menginisialisasi layanan server latar belakang...");

    // 1. Bersihkan socket lama pada port yang sama & proses tunnel lama
    try {
        shell.Run('cmd /c for /f "tokens=5" %a in (\'netstat -ano ^| findstr ":' + appPort + '" ^| findstr "LISTENING"\') do taskkill /F /PID %a >nul 2>&1', 0, true);
        shell.Run('taskkill /F /IM cloudflared-windows-amd64.exe >nul 2>&1', 0, true);
    } catch(e) {}

    // 2. Jalankan Node.js server secara hidden
    try {
        var nodeCmd = 'cmd /c cd /d "' + baseDir + '" && node server.js';
        shell.Run(nodeCmd, 0, false);
        addCustomLog("[NODE_ENGINE]", "Node.js V8 runtime berhasil dijalankan pada port " + appPort);
    } catch(e) {
        addCustomLog("[ERROR]", "Gagal memulai Node.js: " + e.message);
    }

    // 3. Jalankan Cloudflare Tunnel secara hidden
    try {
        var exePath = baseDir + '\\cloudflared-windows-amd64.exe';
        if (fso && fso.FileExists(exePath)) {
            var cfCmd = 'cmd /c cd /d "' + baseDir + '" && "' + exePath + '" tunnel run --token ' + tunnelToken;
            shell.Run(cfCmd, 0, false);
            addCustomLog("[ZERO_TRUST]", "Cloudflare Tunnel aktif menghubungkan https://" + publicDomain);
        } else {
            addCustomLog("[WARN]", "File cloudflared-windows-amd64.exe tidak ditemukan di: " + exePath);
        }
    } catch(e) {
        addCustomLog("[ERROR]", "Gagal memulai Cloudflare Tunnel: " + e.message);
    }

    // 4. Siap dan menunggu pengguna mengklik tombol "MASUK DASHBOARD"
    setTimeout(function() {
        addCustomLog("[SYSTEM_READY]", "Layanan aktif! Silakan klik tombol 'MASUK DASHBOARD'.");
    }, 2000);
}

function openPortal() {
    addCustomLog("[USER_ACTION]", "Membuka Portal Lokal (Port " + appPort + ")...");
    var url = "http://localhost:" + appPort + "/?auth_key=" + appAccessToken;
    if (shell) shell.Run(url);
    else window.open(url);
}

function openCloud() {
    addCustomLog("[USER_ACTION]", "Membuka Dashboard Laporan: https://" + publicDomain);
    var url = "https://" + publicDomain + "/?auth_key=" + appAccessToken;
    if (shell) shell.Run(url);
    else window.open(url);
}

function runAudit() {
    addCustomLog("[SECURITY_AUDIT]", "Pemeriksaan socket selesai. 0 ancaman terdeteksi. Protokol QUIC TLS 1.3 Aktif.");
}

// Bersihkan semua proses saat mematikan
function killAllServices() {
    if (!shell) return;
    try {
        // Matikan listener port
        shell.Run('cmd /c for /f "tokens=5" %a in (\'netstat -ano ^| findstr ":' + appPort + '" ^| findstr "LISTENING"\') do taskkill /F /PID %a >nul 2>&1', 0, true);
        // Matikan tunnel
        shell.Run('taskkill /F /IM cloudflared-windows-amd64.exe >nul 2>&1', 0, true);
    } catch(e) {}
}

function shutdownServer() {
    if (confirm("Apakah Anda yakin ingin mematikan seluruh server dan menutup dashboard?")) {
        killAllServices();
        window.close();
    }
}

// Event saat jendela ditutup (klik tombol X di pojok kanan atas)
function onAppExit() {
    killAllServices();
}

// Log streaming queue
var logPool = [
    { tag: "[SECURE_PING]", text: "Localhost loopback verified -- Port active [HTTP 200 OK]" },
    { tag: "[D1_SQL_SYNC]", text: "Edge query dispatched: SELECT * FROM reports WHERE status='OK'" },
    { tag: "[ZERO_TRUST]",  text: "Packet inspection completed: 0 threats detected / AES-256 TLS 1.3" },
    { tag: "[TUNNEL_STATUS]",text: "Cloudflare edge route handshake: syn-ack confirmed from Singapore edge" },
    { tag: "[MEDIA_CDN]",    text: "Cloudinary asset pipeline synced: signatures verified for bucket ixjihcvx" },
    { tag: "[DUAL_STORAGE]", text: "Cache coherency check: Local IndexedDB [SYNC] Cloudflare D1" },
    { tag: "[MEMORY_GC]",    text: "V8 Engine Heap: 36.4 MB / 14 active sockets / Garbage Collection optimal" },
    { tag: "[SECURITY_AUDIT]",text: "Encryption keys rotated: Session auth valid. Zero vulnerabilities" }
];

function getTimeStr() {
    var d = new Date();
    var h = ("0" + d.getHours()).slice(-2);
    var m = ("0" + d.getMinutes()).slice(-2);
    var s = ("0" + d.getSeconds()).slice(-2);
    return h + ":" + m + ":" + s;
}

function addLog() {
    var box = document.getElementById('logbox');
    if (!box) return;
    var item = logPool[Math.floor(Math.random() * logPool.length)];
    var t = getTimeStr();
    
    var el = document.createElement('div');
    el.className = 'log-line';
    el.innerHTML = '<span class="log-time">[' + t + ']</span> <span class="log-tag">' + item.tag + '</span> ' + item.text;
    box.appendChild(el);
    box.scrollTop = box.scrollHeight;
}

function addCustomLog(tag, msg) {
    var box = document.getElementById('logbox');
    if (!box) return;
    var t = getTimeStr();
    var el = document.createElement('div');
    el.className = 'log-line';
    el.innerHTML = '<span class="log-time">[' + t + ']</span> <span class="log-tag">' + tag + '</span> ' + msg;
    box.appendChild(el);
    box.scrollTop = box.scrollHeight;
}

// Inisialisasi awal saat aplikasi terbuka
window.onload = function() {
    loadEnv();
    bootstrapServices();
    setInterval(addLog, 2500);
};

// Live Telemetry Animation
var step = 0;
setInterval(function() {
    step++;
    var c = Math.floor(Math.random() * 25) + 25; // 25% - 50%
    var health = 100 - Math.floor(c / 3);       // 84% - 92%
    var netMb = (Math.random() * 8 + 3).toFixed(1);
    var memGb = (1.18 + Math.random() * 0.08).toFixed(2);
    var socks = Math.floor(Math.random() * 6) + 12;
    
    var cpuEl = document.getElementById('cpu');
    var netEl = document.getElementById('net');
    var memEl = document.getElementById('mem');
    var sockEl = document.getElementById('sock');
    if (cpuEl) cpuEl.innerText = c + '%';
    if (netEl) netEl.innerText = netMb + ' MB/s';
    if (memEl) memEl.innerText = memGb + ' GB';
    if (sockEl) sockEl.innerText = socks;
    
    var pbar = document.getElementById('pbar');
    if (pbar) pbar.style.width = health + '%';
    var htxt = document.getElementById('health-txt');
    if (htxt) htxt.innerText = health + '% [OPTIMAL]';
    
    var pulse = document.getElementById('pulse');
    if (pulse) pulse.style.opacity = (step % 2 === 0) ? '1' : '0.4';
}, 1500);
</script>

</body>
</html>
